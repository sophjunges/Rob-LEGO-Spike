from hub import port, light_matrix, sound
import runloop, motor_pair, motor, distance_sensor, force_sensor, color_sensor, color

motor_pair.pair(motor_pair.PAIR_1, port. C, port. D)
#velocidades
velocidade_alta = 1000
velocidade_media = 500
velocidade_baixa = 200

async def main():

   
    obstaculo_detectado = False

    while True :
        if color_sensor.color(port. B) == color.RED:
            motor_pair.stop(motor_pair.PAIR_1)

            await sound.beep(600, 300, 100)
            await sound.beep(800, 200, 100)
            light_matrix.show_image(light_matrix.IMAGE_ASLEEP)
            break

        distancia = distance_sensor.distance(port.F)
        toque = force_sensor.pressed(port.A)

        if distancia != -1 and distancia < 50 or toque:
            motor_pair.stop(motor_pair.PAIR_1)
            obstaculo_detectado = True

        elif obstaculo_detectado and distancia > 50 and not toque:
            await motor.run_for_degrees(port. C, 720, 300)
            obstaculo_detectado = False

        elif distancia <= 100:
            motor_pair.move(
                motor_pair.PAIR_1,
                0,
                velocity= velocidade_baixa
            )
        elif distancia <= 200:
            motor_pair.move(
                motor_pair.PAIR_1,
                0,
                velocity= velocidade_media
            )
        else:
            motor_pair.move(
                motor_pair.PAIR_1,
                0,
                velocity= velocidade_alta
            )
        await runloop.sleep_ms(50)

runloop.run(main())

