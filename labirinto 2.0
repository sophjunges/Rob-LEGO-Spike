from hub import port, motion_sensor
import motor, motor_pair, distance_sensor,runloop


MOTOR_ESQUERDO = port.C
MOTOR_DIREITO = port.D
SENSOR_DISTANCIA = port.B
SENSOR_COR = port.E

VELOCIDADE = 200
DISTANCIA_OBSTACULO = 50
VELOCIDADE_GIRO = 200
CM_PER_ROT = 17.6

motor_pair.pair(
    motor_pair.PAIR_1,
    MOTOR_ESQUERDO,
    MOTOR_DIREITO
)

def deg_for_cm(cm):
    return int(cm / CM_PER_ROT * 360)

async def virar_20():
    await motor_pair.move_for_degrees(
    motor_pair.PAIR_1,
    deg_for_cm(20),
    0,
    velocity= VELOCIDADE
    )
def turn():
    # convert tuple decidegree into same format as in app and blocks
    return abs(motion_sensor.tilt_angles()[0] * -0.1) > 90

def andar():
    motor_pair.move(
        motor_pair.PAIR_1,
        0,
        velocity=VELOCIDADE
    )

def parar():
    motor_pair.stop(
        motor_pair.PAIR_1,
        stop=motor.BRAKE
    )
async def turn_done():
    motor_pair.pair(motor_pair.PAIR_1, port.C, port.D)
    motion_sensor.reset_yaw(0)
    await runloop.until(motion_sensor.stable)
    motor_pair.move(motor_pair.PAIR_1, 50, velocity=VELOCIDADE_GIRO)
    await runloop.until(turn)
    motor_pair.stop(motor_pair.PAIR_1)
 
async def virar_direita_90():
    await motor_pair.move_for_degrees(
        motor_pair.PAIR_1,
        -180,
        100,
        velocity=VELOCIDADE_GIRO
    )
async def virar_180():
    await motor_pair.move_for_degrees(
        motor_pair.PAIR_1,
        -360,
        100,
        velocity=VELOCIDADE_GIRO
    )

def obstaculo_detectado():
    distancia = distance_sensor.distance(
        SENSOR_DISTANCIA
    )
    if distancia != -1 and distancia <= DISTANCIA_OBSTACULO:
        return True
    return False

async def main():
    while True:
        andar()
        if obstaculo_detectado():
            parar()
            await virar_direita_90()
            await runloop.sleep_ms(150)
            distancia = distance_sensor.distance(
                SENSOR_DISTANCIA
            )
            if distancia != -1 and distancia <= DISTANCIA_OBSTACULO:
                # Ainda existe parede na frente.
                # Então faz 180°.
                parar()
                await virar_180()
                await runloop.sleep_ms(150)
        await runloop.sleep_ms(10)
runloop.run(main())
